{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "security:minimumReleaseAgeNpm"],
  "timezone": "America/New_York",
  "schedule": ["* 0-5 * * 1"],
  "labels": ["renovate"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "One PR per repo for workflow action bumps, not one per action",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Language runtime bumps (base images, version files) break builds like majors do; keep them out of the non-major bundle",
      "matchDepNames": ["python", "node", "php"],
      "matchUpdateTypes": ["minor"],
      "groupName": "language runtime"
    },
    {
      "description": "These majors peer on each other, so one PR each can never lock alone",
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "vite-plugin-pwa"],
      "matchUpdateTypes": ["major"],
      "groupName": "vite"
    },
    {
      "description": "These majors peer on each other, so one PR each can never lock alone",
      "matchPackageNames": ["@sveltejs/kit", "@sveltejs/adapter-*", "@sveltejs/vite-plugin-svelte"],
      "matchUpdateTypes": ["major"],
      "groupName": "sveltekit"
    }
  ]
}
