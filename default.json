{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "America/New_York",
  "schedule": ["* 0-5 * * 1"],
  "labels": ["renovate"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "One PR per repo for workflow action bumps, not one per action",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Language runtime bumps (base images, version files) break builds like majors do; keep them out of the non-major bundle",
      "matchDepNames": ["python", "node", "php"],
      "matchUpdateTypes": ["minor"],
      "groupName": "language runtime"
    }
  ]
}
