{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "at any time"
  ],
  "labels": [
    "renovate"
  ],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "One PR per repo for workflow action bumps, not one per action",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "prConcurrentLimit": 0
}
